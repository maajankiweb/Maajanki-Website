{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "position: sticky",
          "inset",
          "user-select"
        ]
      }
    ],
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "link[referrerpolicy]",
          "meta[name=theme-color]",
          "img[loading]"
        ]
      }
    ],
    "highest-available-document-mode": "off"
  }
}